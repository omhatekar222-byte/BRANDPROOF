# BrandProof backend — copy to .env and fill in real values. Never commit .env.

APP_NAME=BrandProof API
ENV=development
API_PREFIX=/api

# Local fallback (SQLite). For production use a managed PostgreSQL URL:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/brandproof
DATABASE_URL=sqlite:///./brandproof.db

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RESET_TOKEN_EXPIRE_MINUTES=30

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
ALLOWED_UPLOAD_EXTENSIONS=[".pdf",".txt",".md",".docx",".png",".jpg",".jpeg",".webp"]

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI layer (provider-agnostic, OpenAI-compatible). Leave provider "none" for demo/deterministic mode.
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45

EMBEDDINGS_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=512

SEED_DEMO_DATA=true
